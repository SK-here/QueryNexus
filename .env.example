# -------------------------------------------------------------
# LLM Provider Configuration
# Supported providers: openai, gemini, groq, deepseek, ollama, anthropic, openrouter, mistral, custom
# -------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=

# Provider-specific keys (can be used individually):
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Examples:
# For Google Gemini:
#   LLM_PROVIDER=gemini
#   GEMINI_API_KEY=AIzaSy...
#   LLM_MODEL=gemini-2.0-flash
#
# For Local Ollama (Free / No API Key):
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.2
#   LLM_BASE_URL=http://localhost:11434/v1
#
# For Groq Cloud (Ultra Fast):
#   LLM_PROVIDER=groq
#   GROQ_API_KEY=gsk_...
#   LLM_MODEL=llama-3.3-70b-versatile
#
# For DeepSeek:
#   LLM_PROVIDER=deepseek
#   DEEPSEEK_API_KEY=sk-...
#   LLM_MODEL=deepseek-chat
#
# For Anthropic Claude:
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   LLM_MODEL=claude-3-5-sonnet-20241022

# -------------------------------------------------------------
# Database defaults
# -------------------------------------------------------------
SQL_URL=sqlite:///./demo.db
SQL_USER=demo
SQL_PASSWORD=

# -------------------------------------------------------------
# Agent safety & execution settings
# -------------------------------------------------------------
ALLOW_WRITES=false
MAX_ROWS=100
MAX_RETRIES=3
QUERY_TIMEOUT_SECONDS=30
